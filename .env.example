# Plantilla de variables de entorno.
# Copia este archivo como `.env` y rellena los valores.
# NUNCA subas el `.env` real al repositorio (ya está en .gitignore).

# ─── Servidor ────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Base de datos ──────────────────────────
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=

# ─── JWT ────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ─── Frontend ───────────────────────────────
# Origen del cliente Angular. Se usa para construir el enlace de recuperación
# de contraseña: {FRONTEND_URL}/auth/reset-password?token=...
FRONTEND_URL=http://localhost:4200

# ─── Correo transaccional (Resend) ──────────
# Clave de API generada en https://resend.com/api-keys
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend; para pruebas puede
# usarse el remitente de prueba de Resend.
# Ejemplo: PantSys <no-reply@tudominio.com>
EMAIL_FROM=
